# DATAFIX AI Backend Configuration
APP_NAME=DATAFIX AI API
APP_VERSION=1.0.0

# Local SQLite default (for Render Persistent Disk use e.g. sqlite:////var/data/datafix.db)
DATABASE_URL=sqlite:///./datafix.db

# Local storage defaults (for Render Persistent Disk use e.g. /var/data/uploads and /var/data/exports)
UPLOAD_DIR=uploads
EXPORT_DIR=exports

MAX_UPLOAD_SIZE_MB=25
PREVIEW_ROW_LIMIT=50

# CORS origins (comma-separated, no wildcard, no trailing slash or subpath)
ALLOWED_ORIGINS=https://harsh0007-crypto.github.io,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Leave empty in production to disable regex origin matching
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
